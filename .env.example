
DISCORD_TOKEN=
OWNER_ID=1140900506198351924

# Discord OAuth: local-only option uses http://127.0.0.1:8765 and requires that exact callback URL in the Discord Developer Portal.
# For a public deployment, use the HTTPS dashboard URL and its /oauth/callback redirect URI.
# Never commit real secrets.
DASHBOARD_PUBLIC_URL=http://127.0.0.1:8765
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Generate a random secret with at least 32 characters.
DASHBOARD_SESSION_SECRET=
DASHBOARD_WHITELIST_IDS=1338493569781989407
ALLOWED_ROLE_ID=1509577038443319416


GUILD_IDS=


FREEMIND_AI_BASE_URL=http://127.0.0.1:8080
# Optional: project directory for the local FreeMindAI app. Auto-discovery checks common folders if blank.
FREEMIND_AI_PROJECT_DIR=

FREEMIND_AI_PASSWORD=

# Optional preferred Lavalink nodes. Keep credentials only in .env.
# The bot also appends two currently listed public community nodes as fallbacks.
# Configure URI and PASSWORD together for each custom node; public nodes are best-effort.
LAVALINK_1_IDENTIFIER=lavalink-primary
LAVALINK_1_URI=
LAVALINK_1_PASSWORD=
LAVALINK_2_IDENTIFIER=lavalink-fallback-1
LAVALINK_2_URI=
LAVALINK_2_PASSWORD=
LAVALINK_3_IDENTIFIER=lavalink-fallback-2
LAVALINK_3_URI=
LAVALINK_3_PASSWORD=

FREEMIND_AI_TIMEOUT=45


GEMINI_API_KEY=

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash


GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: enables /generate_image (requires OpenAI API billing and image-model access)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1


OCR_SPACE_API_KEY=


POLL_ANON_SECRET=


FFMPEG_PATH=


OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=90
OLLAMA_MAX_TOKENS=90

OLLAMA_BANTER_CHANNEL_IDS=

OLLAMA_SYSTEM_PROMPT=
