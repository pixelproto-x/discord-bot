
DISCORD_TOKEN=
OWNER_ID=1140900506198351924

# Discord OAuth: local-only option uses http://127.0.0.1:8765 and requires that exact callback URL in the Discord Developer Portal.
# For a public deployment, use the HTTPS dashboard URL and its /oauth/callback redirect URI.
# Never commit real secrets.
DASHBOARD_PUBLIC_URL=http://127.0.0.1:8765
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Generate a random secret with at least 32 characters.
DASHBOARD_SESSION_SECRET=
DASHBOARD_WHITELIST_IDS=1338493569781989407
ALLOWED_ROLE_ID=1509577038443319416


GUILD_IDS=


FREEMIND_AI_BASE_URL=http://127.0.0.1:8080
# Optional: project directory for the local FreeMindAI app. Auto-discovery checks common folders if blank.
FREEMIND_AI_PROJECT_DIR=

FREEMIND_AI_PASSWORD=

# Optional preferred Lavalink nodes. Keep credentials only in .env.
# The bot also appends two currently listed public community nodes as fallbacks.
# Configure URI and PASSWORD together for each custom node; public nodes are best-effort.
LAVALINK_1_IDENTIFIER=lavalink-primary
LAVALINK_1_URI=
LAVALINK_1_PASSWORD=
LAVALINK_2_IDENTIFIER=lavalink-fallback-1
LAVALINK_2_URI=
LAVALINK_2_PASSWORD=
LAVALINK_3_IDENTIFIER=lavalink-fallback-2
LAVALINK_3_URI=
LAVALINK_3_PASSWORD=

FREEMIND_AI_TIMEOUT=45

# AI provider configuration. Leave keys blank to disable a provider.
# Google AI Studio / Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq Cloud: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter: https://openrouter.ai/settings/keys
# Only openrouter/free or model IDs ending in :free are accepted.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://github.com/pixelproto-x/discord-bot
OPENROUTER_APP_NAME=Discord Bot

# Cloudflare Workers AI: https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# GitHub Models: https://github.com/settings/personal-access-tokens
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# SiliconFlow: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3-8B

# Zhipu AI: https://open.bigmodel.cn/
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.5-flash

# SambaNova Cloud: https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Cerebras Cloud: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Cohere Trial: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025

# Mistral La Plateforme: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Hugging Face Serverless Inference: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# NVIDIA NIM: https://build.nvidia.com/
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# Ollama local; no API key required.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=90
OLLAMA_MAX_TOKENS=90

# Shared timeout for each provider in the fallback chain.
AI_PROVIDER_TIMEOUT=12

# Optional: enables /generate_image (requires OpenAI API billing and image-model access)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1


OCR_SPACE_API_KEY=


POLL_ANON_SECRET=


FFMPEG_PATH=


OLLAMA_BANTER_CHANNEL_IDS=

OLLAMA_SYSTEM_PROMPT=
