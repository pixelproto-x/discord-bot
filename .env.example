# Discord
DISCORD_TOKEN=
OWNER_ID=1140900506198351924
ALLOWED_ROLE_ID=1509577038443319416

# Optional comma-separated Discord server IDs. Leave blank to allow all servers.
GUILD_IDS=

# Gemini AI
GEMINI_API_KEY=
# Optional alias supported by the bot if you prefer Google's standard variable name.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq AI (fallback for Gemini chat/translation/summary; also used by /ai ask)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OCR（可選）
OCR_SPACE_API_KEY=

# 匿名投票的穩定密鑰；不填時會使用 DISCORD_TOKEN 當作密鑰來源。
POLL_ANON_SECRET=

# 音樂（可選；沒填就自動尋找 PATH 裡的 ffmpeg）
FFMPEG_PATH=

# Local AI banter (Ollama; no Gemini/OpenAI API key needed)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=90
OLLAMA_MAX_TOKENS=220
# Optional: comma-separated channel IDs. Blank allows all channels when the bot is mentioned/replied to.
OLLAMA_BANTER_CHANNEL_IDS=
# Optional: replace the default Taiwanese banter personality
OLLAMA_SYSTEM_PROMPT=
